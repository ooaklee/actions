{
  "name": "@ooaklee/actions",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "repository": "https://github.com/ooaklee/actions.git",
  "author": "Leon Silcott <leon@boasi.io>",
  "workspaces": {
    "packages": [
      "go-example"
    ],
    "nohoist": [
      "node_modules"
    ]
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "yaml": "2.9.1"
  },
  "scripts": {
    "prepare": "husky",
    "test": "yarn test:docs && yarn readme:check && yarn workspaces run test",
    "package": "yarn workspaces run package",
    "readme": "yarn workspaces run readme",
    "test:docs": "node --test scripts/action-docs.test.cjs",
    "readme:check": "yarn workspaces run readme --check"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,json}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "yarn": "1.22.22"
  }
}
